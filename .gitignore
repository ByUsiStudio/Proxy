# idea ignore
.idea/
*.ipr
*.iml
*.iws
/target
/log
node_modules
/dist
/.db
/git.sh
target
# 并行构建的隔离输出目录（见根 pom 的 build.suffix）
target-*
# 运行期产物：应用日志目录与后台生成的统计报表（见 logback-proxy.xml / admin.report.dir）
logs/
report/
*.bak
build/*
go.sum
proxy.zip
/proxy-client-golang/build/*
/proxy-client-golang/*.zip
/.vscode
/.choccy
/proxy-android-client/.gradle/
/proxy-android-client/.acside
/proxy-android-client/.idea
/proxy-android-client/build
# 本地构建缓存（沙箱/CI 下把 Go 缓存放在工作区内）
.gocache/
.gomodcache/
.gotmp/
.m2repo/
# 二维码回归测试的生成物（见 tools/README.md，运行后本地重建）
tools/qr-verify/qrverify
tools/qr-verify/qrverify.exe
tools/qr-verify/texts.txt
tools/qr-verify/ref.txt
# 上面的 go.sum 全局忽略不适用于验证工具：它需要 go.sum 才能离线构建
!tools/qr-verify/go.sum
